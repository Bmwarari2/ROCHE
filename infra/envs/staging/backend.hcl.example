# Copy to backend.hcl (git-ignored) and run:
#   terraform init -backend-config=backend.hcl
# The bucket is created once per project by the bootstrap step in infra/README.md.

bucket = "harbour-tfstate-<staging-project-id>"
prefix = "staging"

# Optional: encrypt state with a customer-managed key in europe-west2.
# kms_encryption_key = "projects/<staging-project-id>/locations/europe-west2/keyRings/harbour-tfstate/cryptoKeys/state"
