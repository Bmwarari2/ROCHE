# Copy to terraform.tfvars (git-ignored) and fill in. CI passes the same values as TF_VAR_*
# environment variables from GitHub repository variables instead.

aws_account_id    = "000000000000"
domain_name       = "prod.harbour.example.invalid"
route53_zone_id   = null

# The signed safety case report this release runs under (docs/clinical-safety/safety-case/).
safety_case_version = "v0.0"
state_bucket_name = "harbour-tfstate-000000000000"
state_kms_key_arn = "arn:aws:kms:eu-west-2:000000000000:key/00000000-0000-0000-0000-000000000000"

alert_email_addresses  = ["platform-alerts@example.invalid"]
budget_email_addresses = ["finance-alerts@example.invalid"]

enable_flagsmith = false

# Every AWS managed rule group that blocks must be pinned before a prod plan (human action H-140).
# Read the versions in the prod account with aws wafv2 list-available-managed-rule-group-versions.
# waf_managed_rule_group_versions = {
#   AWSManagedRulesAmazonIpReputationList = "Version_x.y"
#   AWSManagedRulesCommonRuleSet          = "Version_x.y"
#   AWSManagedRulesKnownBadInputsRuleSet  = "Version_x.y"
#   AWSManagedRulesSQLiRuleSet            = "Version_x.y"
# }

# Only for a group the account lists no versions for (check AWSManagedRulesAmazonIpReputationList
# first; human action H-140): leave it out of the pins above and give the reason here.
# waf_managed_rule_groups_unversioned = {
#   AWSManagedRulesAmazonIpReputationList = "AWS lists no static versions for this group (checked dd/mm/yyyy)."
# }
