# Copy to terraform.tfvars (git-ignored) and fill in. CI passes the same values as TF_VAR_*
# environment variables from GitHub repository variables instead.

project_id        = "harbour-prod-000000"
domain_name       = "prod.harbour.example.invalid"
dns_zone_name     = null
state_bucket_name = "harbour-tfstate-harbour-prod-000000"

# The signed safety case report this release runs under (docs/clinical-safety/safety-case/).
safety_case_version = "v0.0"

alert_email_addresses = ["platform-alerts@example.invalid"]
billing_account_id    = null

enable_flagsmith = false

# Outgoing email through a UK SMTP provider on the sub-processor register (null: email off).
# smtp = { host = "smtp.example.invalid", port = 587, tls = true }

# Every Cloud Armor preconfigured rule must be pinned before a prod plan (human action H-140).
# List the versions with: gcloud compute security-policies list-preconfigured-expression-sets
# armor_rule_versions = {
#   sqli              = "v33-stable"
#   xss               = "v33-stable"
#   lfi               = "v33-stable"
#   rfi               = "v33-stable"
#   rce               = "v33-stable"
#   methodenforcement = "v33-stable"
#   scannerdetection  = "v33-stable"
#   protocolattack    = "v33-stable"
#   sessionfixation   = "v33-stable"
# }
