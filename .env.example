# Copy to .env for local development. Every value here is a local-only default; deployed environments
# take secrets from AWS Secrets Manager. Never commit .env.

# Database (local Postgres; see docs/runbooks/local-development.md)
DATABASE_ADMIN_URL=postgres://harbour_admin:harbour_admin_local@localhost:5432/postgres
DATABASE_OWNER_URL=postgres://harbour_owner:harbour_owner_local@localhost:5432/harbour
DATABASE_APP_URL=postgres://harbour_app:harbour_app_local@localhost:5432/harbour
DATABASE_AUTH_URL=postgres://harbour_auth:harbour_auth_local@localhost:5432/harbour
DATABASE_WORKER_URL=postgres://harbour_worker:harbour_worker_local@localhost:5432/harbour
HARBOUR_TEST_ADMIN_URL=postgres://harbour_admin:harbour_admin_local@localhost:5432/postgres
POSTGRES_ADMIN_PASSWORD=harbour_admin_local

# API
PORT=4000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=local-development-secret-change-me-0123456789
WEB_ORIGINS=http://localhost:3000
PASSKEY_RP_ID=localhost
POWERSYNC_URL=http://localhost:8080
# SYNC_SIGNING_KEY_PEM is generated per process when unset (local only).
LOG_LEVEL=info
# Flagsmith is optional and off while the key is unset; flags then come from the catalogue and the
# organisation's own overrides. Locally: docker compose --profile flagsmith up -d (infra/README.md).
# FLAGSMITH_API_URL=http://localhost:8000/api/v1
# FLAGSMITH_ENVIRONMENT_KEY=
# The browser idle timeout stays off until HZ-111 is controlled and H-353 decided; production
# refuses it. Tests turn it on to prove it.
# SESSION_IDLE_TIMEOUT=off

# Web
API_URL=http://localhost:4000

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DEMO_MODE=0

# Demo data (local only)
HARBOUR_DEMO_PASSWORD=correct horse battery staple
HARBOUR_DEMO_MFA=on
