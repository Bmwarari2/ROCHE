{
  "name": "harbour",
  "private": true,
  "description": "Harbour: multi-tenant platform for UK adult social care providers (Thapsus Cargo Ltd)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:db": "turbo run test:db",
    "db:migrate": "pnpm --filter @harbour/db migrate",
    "db:seed": "pnpm --filter @harbour/db seed",
    "db:reset": "pnpm --filter @harbour/db reset",
    "storybook": "pnpm --filter @harbour/ui storybook",
    "check:licences": "node scripts/check-licences.mjs",
    "check:docs-gate": "node scripts/check-docs-gate.mjs",
    "check:medicines-tests": "node scripts/check-medicines-tests.mjs",
    "changeset": "changeset",
    "prepare": "husky",
    "db:bootstrap": "pnpm --filter @harbour/db bootstrap",
    "check:links": "node scripts/check-markdown-links.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome",
      "unrs-resolver"
    ],
    "ignoredOptionalDependencies": [
      "sharp"
    ],
    "packageExtensions": {
      "next": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    },
    "overrides": {
      "node-forge@<1.4.2": "1.4.2",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "zod@>=4.0.0 <4.6.6": "4.6.6",
      "tmp@<0.2.6": "0.2.7",
      "basic-ftp@<6.2.1": "6.2.3",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "uuid@<11.1.1": "11.1.1",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-qr28-fpjm-wq7f",
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-7pqw-9j4j-h8q3",
        "GHSA-vcc3-ghjq-m6fr",
        "GHSA-gcqx-w48m-w2h4",
        "GHSA-g3hv-75wg-m249",
        "GHSA-3g3m-2fjr-6pw4"
      ]
    }
  },
  "op-sqlite": {
    "sqlcipher": true
  }
}
