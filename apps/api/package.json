{
  "name": "@harbour/api",
  "version": "0.0.0",
  "private": true,
  "description": "Harbour API: Hono modular monolith with Zod contracts, OpenAPI 3.1, Better Auth, audit and outbox",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run",
    "openapi": "tsx scripts/write-openapi.ts",
    "worker": "tsx watch --env-file-if-exists=../../.env src/jobs/worker.ts",
    "start:worker": "node dist/worker.js",
    "seed:users": "tsx --env-file-if-exists=../../.env scripts/seed-users.ts",
    "exports:run": "tsx --env-file-if-exists=../../.env scripts/run-exports.ts",
    "outbox:run": "tsx --env-file-if-exists=../../.env scripts/run-outbox.ts",
    "e2e:evidence-code": "tsx --env-file-if-exists=../../.env scripts/e2e-evidence-code.ts",
    "break-glass-report:run": "tsx --env-file-if-exists=../../.env scripts/run-break-glass-report.ts",
    "workflow-deadlines:backfill": "tsx --env-file-if-exists=../../.env scripts/backfill-workflow-deadlines.ts",
    "dmd:run": "tsx --env-file-if-exists=../../.env src/jobs/dmd-job.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@better-auth/passkey": "^1.7.7",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@harbour/contracts": "workspace:*",
    "@harbour/db": "workspace:*",
    "@harbour/domain": "workspace:*",
    "@harbour/i18n": "workspace:*",
    "@harbour/sync": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@harbour/config": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/yauzl": "2.10.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
