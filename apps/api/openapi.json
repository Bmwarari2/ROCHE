{
  "openapi": "3.1.0",
  "info": {
    "title": "Harbour API",
    "version": "0.0.0",
    "description": "Internal API for the Harbour web and mobile apps. Every request is scoped to one organisation (x-harbour-tenant) and enforced again by Postgres row-level security."
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Session token from the set-auth-token header (mobile app)"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "harbour.session_token",
        "description": "Session cookie (web app)"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "database"
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantName": {
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "tenantName"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "default": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code"
        ],
        "description": "RFC 9457 problem details with a stable code"
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            },
            "required": [
              "id",
              "name",
              "email"
            ]
          },
          "tenant": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "terminology": {
                "type": "string",
                "enum": [
                  "resident",
                  "client",
                  "person_we_support"
                ]
              },
              "brandAccent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nation": {
                "type": "string",
                "enum": [
                  "england",
                  "wales",
                  "scotland",
                  "northern_ireland"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "terminology",
              "brandAccent",
              "nation"
            ]
          },
          "tenantUserId": {
            "type": "string",
            "format": "uuid"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationSummary"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roleKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "$ref": "#/components/schemas/DataScope"
          },
          "flags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "user",
          "tenant",
          "tenantUserId",
          "memberships",
          "locations",
          "permissions",
          "roleKeys",
          "scope",
          "flags"
        ],
        "description": "The signed-in user, their active tenant and effective access"
      },
      "LocationSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "regulator": {
            "type": "string",
            "enum": [
              "cqc",
              "ciw",
              "care_inspectorate",
              "rqia",
              "ofsted"
            ]
          },
          "regulatorLocationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "nation": {
            "type": "string",
            "enum": [
              "england",
              "wales",
              "scotland",
              "northern_ireland"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "regulator",
          "regulatorLocationId",
          "nation"
        ]
      },
      "DataScope": {
        "type": "string",
        "enum": [
          "tenant",
          "locations",
          "assigned",
          "none"
        ]
      },
      "PersonList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonSummary"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "PersonSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "enquiry",
              "active",
              "on_leave",
              "in_hospital",
              "discharged",
              "deceased",
              "archived"
            ]
          },
          "givenName": {
            "type": "string"
          },
          "familyName": {
            "type": "string"
          },
          "preferredName": {
            "type": [
              "string",
              "null"
            ]
          },
          "dateOfBirth": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "nhsNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "photoUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "allergyStatus": {
            "$ref": "#/components/schemas/AllergyStatus"
          },
          "allergies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "substance": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "reaction": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "substance",
                "severity",
                "reaction"
              ]
            }
          },
          "communicationNeeds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunicationNeed"
            }
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "locationId",
          "status",
          "givenName",
          "familyName",
          "preferredName",
          "dateOfBirth",
          "nhsNumber",
          "photoUrl",
          "allergyStatus",
          "allergies",
          "communicationNeeds",
          "version"
        ]
      },
      "AllergyStatus": {
        "type": "string",
        "enum": [
          "unknown",
          "no_known_allergies",
          "has_allergies"
        ]
      },
      "CommunicationNeed": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "SNOMED CT concept id (Accessible Information Standard)"
          },
          "display": {
            "type": "string"
          },
          "preferredFormat": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "display"
        ]
      },
      "RecordHistory": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string"
          },
          "recordId": {
            "type": "string",
            "format": "uuid"
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordVersion"
            }
          }
        },
        "required": [
          "table",
          "recordId",
          "versions"
        ],
        "description": "Human-readable history of a mutable record"
      },
      "RecordVersion": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer"
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validTo": {
            "type": "string",
            "format": "date-time"
          },
          "changedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "data": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "version",
          "validFrom",
          "validTo",
          "changedBy",
          "data"
        ]
      },
      "BreakGlassResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "expiresAt"
        ]
      },
      "BreakGlassRequest": {
        "type": "object",
        "properties": {
          "personId": {
            "type": "string",
            "format": "uuid"
          },
          "justification": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "personId",
          "justification"
        ]
      },
      "NotificationList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationItem"
            }
          },
          "unread": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "unread"
        ]
      },
      "NotificationItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "urgent"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "acknowledgedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "title",
          "body",
          "link",
          "createdAt",
          "readAt",
          "acknowledgedAt"
        ]
      },
      "AuditList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          },
          "chainIntact": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "chainIntact"
        ]
      },
      "AuditEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "denied",
              "error"
            ]
          },
          "actorTenantUserId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "resourceType": {
            "type": [
              "string",
              "null"
            ]
          },
          "resourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "chainPosition": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "occurredAt",
          "action",
          "outcome",
          "actorTenantUserId",
          "resourceType",
          "resourceId",
          "reason",
          "chainPosition"
        ]
      },
      "FormTemplateSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "locked": {
            "type": "boolean"
          },
          "global": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "key",
          "version",
          "title",
          "kind",
          "locked",
          "global"
        ]
      },
      "RateValue": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "nation": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "tenantOverride": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "value",
          "unit",
          "nation",
          "verified",
          "source",
          "tenantOverride"
        ]
      },
      "SyncToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "token",
          "endpoint",
          "expiresAt"
        ],
        "description": "Short-lived PowerSync token scoped to tenant and assignments"
      },
      "SyncUploadResult": {
        "type": "object",
        "properties": {
          "applied": {
            "type": "integer"
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "code",
                "message"
              ]
            }
          }
        },
        "required": [
          "applied",
          "rejected"
        ]
      },
      "SyncUpload": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncOperation"
            },
            "maxItems": 500
          }
        },
        "required": [
          "operations"
        ]
      },
      "SyncOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "table": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {}
          },
          "deviceSentAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "op",
          "table",
          "id"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Liveness and database reachability (no personal data)",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Degraded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memberships": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Organisations the signed-in person belongs to",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Memberships",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Membership"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "The signed-in user, their active organisation and effective access",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Not a member, missing permission, MFA not set up or step-up needed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request did not validate",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/people": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "People in your scope, with the point-of-care header details",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "locationId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "People",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonList"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Not a member, missing permission, MFA not set up or step-up needed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request did not validate",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/people/{id}": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "One person's point-of-care summary",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Person",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonSummary"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Not a member, missing permission, MFA not set up or step-up needed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not found or outside your access",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request did not validate",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/people/{id}/history": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "Every earlier version of a person's record, for inspectors and audit",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
