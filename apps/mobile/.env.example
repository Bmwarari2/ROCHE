# Copy to .env.local (never commit it). Values are inlined into the JavaScript bundle at build time,
# so nothing secret may ever go here.

# Harbour API base URL. Android emulators reach the host machine at http://10.0.2.2:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000

# 1 = demo mode: no API, the local encrypted database is seeded with three invented people.
EXPO_PUBLIC_DEMO_MODE=0
