{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "pnpm": "10.28.0",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "0"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dev.harbour.example.invalid"
      },
      "ios": { "simulator": true }
    },
    "development-device": {
      "extends": "development",
      "ios": { "simulator": false }
    },
    "e2e": {
      "extends": "base",
      "distribution": "internal",
      "channel": "e2e",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "1",
        "EXPO_PUBLIC_API_URL": "http://localhost:4000"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.harbour.example.invalid"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "ios": { "image": "latest" },
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.harbour.example.invalid"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
