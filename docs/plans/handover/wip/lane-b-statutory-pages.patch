+/** To do (overdue, due, or a clock the web does not know) and done, each in order. */
+export function notificationGroups<N extends Pick<StatutoryNotificationSummary, "clock" | "dueAt">>(
+  items: readonly N[],
+): { readonly todo: N[]; readonly done: N[] } {
+  const ordered = notificationsInOrder(items);
+  return {
+    todo: ordered.filter((n) => n.clock !== "done"),
+    done: ordered.filter((n) => n.clock === "done"),
+  };
+}
+
+/** One deadline in the catalogue's words with its time, never the API's English wording. */
+export function deadlineLine(
+  deadline: { readonly key: string; readonly dueAt: string },
+  t: Translator,
+): { readonly text: string; readonly dateTime: string } {
+  return {
+    text: t("safety.notification.deadline", {
+      deadline: deadline.key,
+      dateTime: formatDateTime(deadline.dueAt) ?? t("common.notRecorded"),
+    }),
+    dateTime: deadline.dueAt,
+  };
+}
+
+/** Where a notification comes from: its incident, the person's DoLS register, or their record. */
+export function notificationSource(
+  item: Pick<StatutoryNotificationSummary, "incidentId" | "personId" | "dolsAuthorisationId">,
+): { readonly href: string; readonly source: "incident" | "dols" | "person" } | null {
+  if (item.incidentId) return { href: `/incidents/${item.incidentId}`, source: "incident" };
+  if (!item.personId) return null;
+  return item.dolsAuthorisationId
+    ? { href: `/people/${item.personId}/capacity`, source: "dols" }
+    : { href: `/people/${item.personId}`, source: "person" };
+}
